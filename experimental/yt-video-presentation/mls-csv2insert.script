# ---------------------------------------------------------------- Szene 5
clear
text
Jetzt die Schleife: eine Zeile lesen, Feldzahl prüfen, sonst überspringen.
end
pause 0.8

code
int len = s_strlen(buf);   // Checkpoint: nur der Header

for (;;) {
    int fields = vs_read_fields(vset, "fields", stdin, ",");
    if (vs_klen(fields) == 0)
        break;                 // EOF
    if (vs_klen(fields) != NCOLS)
        continue;              // Formatfehler überspringen
    /* INSERT-Zeile */
}
end
