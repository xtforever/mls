clear
text
Kernmodell: ein Array ist ein int-Handle, kein roher Pointer.
end
pause 0.8

code
m_init();
int h = m_alloc(0, sizeof(int), MFREE);
int v = 42;
m_put(h, &v);               // anhängen
printf("%d\n", INT(h, 0));  // 42, bounds-checked
m_free(h);
m_destruct();
end
