text
Strings sind ebenfalls Handles. tmls gibt am Blockende automatisch frei.
end
pause 0.8

code
int s = s_cstrdup("hallo");       // String-Handle
s_printf(s, m_len(s), " welt");   // anfügen
printf("%s\n", m_str(s));         // "hallo welt"
m_free(s);
end
