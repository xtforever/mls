# ---------------------------------------------------------------- Szene 6
clear
text
Pro Datensatz: auf den Header zurückspulen und die Werte SQL-quoten.
end
pause 0.8

code
m_setlen(buf, len);    // zurück auf den Header
vs_sql_string_builder(buf, vset, "$'fields[*]' );");
s_puts(buf);
end
