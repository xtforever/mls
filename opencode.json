{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "formatter": true,
  "instructions": ["AGENTS.md", "docs/notes/PFLICHTENHEFT_forth_sql.md"],
  "compaction": {
    "auto": true,
    "tail_turns": 15
  },
  "agent": {
    "plan": {
      "model": "deepseek/deepseek-v4-pro"
    },
    "build": {
      "model": "deepseek/deepseek-flash"
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "make *": "allow",
      "gcc *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "git reset *": "deny"
    }
  }
}
