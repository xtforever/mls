prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: mls
Description: Master List System — safe dynamic arrays for C
Version: @PROJECT_VERSION@
@MLS_PC_LIBS@
Cflags: -I${includedir} @MLS_PC_CFLAGS@
Libs: -L${libdir} -lmls@CMAKE_DEBUG_POSTFIX@ -lm -ldl
Libs.private: @MLS_PC_PRIVATE_LIBS@
