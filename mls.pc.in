prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: mls
Description: Master List System — safe dynamic arrays for C (full build)
Version: @PROJECT_VERSION@
Cflags: -I${includedir}
Libs: -L${libdir} -lmls_ext@CMAKE_DEBUG_POSTFIX@ -lmls_base@CMAKE_DEBUG_POSTFIX@ -lm -ldl
Libs.private: @MLS_PC_PRIVATE_LIBS@
